{
  "name": "@leeruu/agentguard",
  "version": "0.1.2",
  "description": "Local permission gateway for MCP agents: YAML policy, deterministic decisions, full audit trail.",
  "license": "Apache-2.0",
  "author": "leeruu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MmUu001/agentguard.git"
  },
  "homepage": "https://github.com/MmUu001/agentguard#readme",
  "bugs": {
    "url": "https://github.com/MmUu001/agentguard/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentguard": "dist/main.js"
  },
  "files": [
    "dist",
    "packs",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build",
    "check:w1": "node tests/w1-check.mjs",
    "check:w2": "node tests/w2-check.mjs",
    "check:w3": "node tests/w3-check.mjs",
    "check:w4": "node tests/w4-check.mjs",
    "check:w5": "node tests/w5-check.mjs",
    "check:attacks": "node tests/attacks-check.mjs",
    "check:stress": "node tests/stress-check.mjs",
    "check:lint": "node tests/lint-check.mjs",
    "check:coldstart": "node tests/coldstart-check.mjs",
    "check:real": "node tests/real-fs-check.mjs",
    "check:pkg": "node tests/install-check.mjs",
    "check:all": "node tests/w1-check.mjs && node tests/w2-check.mjs && node tests/w3-check.mjs && node tests/w4-check.mjs && node tests/w5-check.mjs && node tests/attacks-check.mjs && node tests/stress-check.mjs && node tests/lint-check.mjs && node tests/coldstart-check.mjs && node tests/real-fs-check.mjs && node tests/export-check.mjs && node tests/epipe-check.mjs && node tests/demo-check.mjs && node tests/012-check.mjs && node tests/install-check.mjs",
    "check:demo": "node tests/demo-check.mjs",
    "check:epipe": "node tests/epipe-check.mjs",
    "check:export": "node tests/export-check.mjs",
    "check:012": "node tests/012-check.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "agent",
    "ai-agent",
    "security",
    "permission",
    "policy",
    "guardrail",
    "firewall",
    "claude-code",
    "cursor",
    "llm"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
